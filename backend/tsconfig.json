{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "..",
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@soumya/shared": ["../shared/src/index.ts"]
    },
    "baseUrl": ".",
    "ignoreDeprecations": "5.0"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}
